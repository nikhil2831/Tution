{
  "name": "student-next-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/db.mjs migrate",
    "db:account": "node --env-file-if-exists=.env.local scripts/db.mjs account",
    "db:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-mysql.ps1",
    "test:e2e": "node --env-file-if-exists=.env.local --test tests/workspace.test.mjs"
  },
  "dependencies": {
    "mysql2": "^3.24.6",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
